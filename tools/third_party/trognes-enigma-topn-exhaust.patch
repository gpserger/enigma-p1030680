+/* ---- --topn hook (added for the P1030680 ciphertext-only run, tools/run_m4) ----
+   Every converged climb's decrypt is rescored with an INDEPENDENT quadgram table
+   (--rescore FILE, "NGRAM count" lines -> mean log10 prob per quadgram) and the best
+   --topn N distinct plaintexts (by that rescore) are kept in a global heap, written to
+   --topn-file at the end and checkpointed every 120 s. Display/output-only: does not
+   change the search. */
+static int opt_topn = 0;
+static const char * opt_topn_file = nullptr;
+static const char * opt_rescore_file = nullptr;
+static std::vector<float> g_rescore_tab;
+struct TopEntry { float rs; double score; std::string pt; std::string line; };
+static std::mutex g_top_mutex;
+static std::vector<TopEntry> g_top;             /* min-heap on rs */
+static std::set<std::string> g_top_pts;
+static std::atomic<float> g_top_min{-1e30f};
+static std::chrono::steady_clock::time_point g_top_lastsave = std::chrono::steady_clock::now();
+static bool top_cmp(const TopEntry & a, const TopEntry & b) { return a.rs > b.rs; }
+static int opt_topn_fwd(void) { return opt_topn; }
+
+static void load_rescore(const char * path)
+{
+  g_rescore_tab.assign(26 * 26 * 26 * 26, 0.0f);
+  std::vector<double> cnt(26 * 26 * 26 * 26, 0.0);
+  FILE * f = fopen(path, "r");
+  if (! f) { fprintf(stderr, "cannot open --rescore file %s\n", path); exit(1); }
+  char g[64]; double v, tot = 0;
+  while (fscanf(f, "%63s %lf", g, &v) == 2)
+    {
+      if (strlen(g) != 4) continue;
+      int idx = 0; bool ok = true;
+      for (int i = 0; i < 4; i++) { int c = toupper((unsigned char) g[i]); if (c < 'A' || c > 'Z') { ok = false; break; } idx = idx * 26 + (c - 'A'); }
+      if (! ok) continue;
+      cnt[idx] += v; tot += v;
+    }
+  fclose(f);
+  float fl = static_cast<float>(log10(0.01 / tot));
+  for (size_t i = 0; i < cnt.size(); i++)
+    g_rescore_tab[i] = cnt[i] > 0 ? static_cast<float>(log10(cnt[i] / tot)) : fl;
+}
+
+static float rescore_pt(const char * pt)
+{
+  float s = 0; int n = 0;
+  for (int i = 0; i + 4 <= textlength; i++, n++)
+    s += g_rescore_tab[(((pt[i]-'A') * 26 + (pt[i+1]-'A')) * 26 + (pt[i+2]-'A')) * 26 + (pt[i+3]-'A')];
+  return n ? s / n : -99.0f;
+}
+
+static void topn_write_locked(void)
+{
+  if (! opt_topn_file) return;
+  std::vector<TopEntry> v = g_top;
+  std::sort(v.begin(), v.end(), top_cmp);
+  std::string tmp = std::string(opt_topn_file) + ".tmp";
+  FILE * f = fopen(tmp.c_str(), "w");
+  if (! f) return;
+  fprintf(f, "#rescore\tscore\tW\tR\tG\tplugs\tplaintext\n");
+  for (const TopEntry & e : v) fprintf(f, "%.4f\t%.4f\t%s\n", e.rs, e.score, e.line.c_str());
+  fclose(f);
+  rename(tmp.c_str(), opt_topn_file);
+}
+
+
+static void topn_offer(machine & m, double score)
+{
+  float rs = rescore_pt(m.plaintext);
+  if (static_cast<int>(g_top.size()) >= opt_topn && rs <= g_top_min.load(std::memory_order_relaxed))
+    return;
+  char w[8], r[8], g[8], s[3 * 13];
+  format_key(m, w, r, g);
+  format_plugboard(m, s);
+  std::string pt(m.plaintext, static_cast<size_t>(textlength));
+  std::lock_guard<std::mutex> lock(g_top_mutex);
+  if (g_top_pts.count(pt)) return;
+  if (static_cast<int>(g_top.size()) >= opt_topn)
+    {
+      if (rs <= g_top.front().rs) return;
+      std::pop_heap(g_top.begin(), g_top.end(), top_cmp);
+      g_top_pts.erase(g_top.back().pt);
+      g_top.pop_back();
+    }
+  char line[512];
+  snprintf(line, sizeof(line), "%s\t%s\t%s\t%s\t%s", w, r, g, s, pt.c_str());
+  g_top.push_back({rs, score, pt, line});
+  std::push_heap(g_top.begin(), g_top.end(), top_cmp);
+  g_top_pts.insert(pt);
+  if (static_cast<int>(g_top.size()) >= opt_topn) g_top_min.store(g_top.front().rs, std::memory_order_relaxed);
+  auto now = std::chrono::steady_clock::now();
+  if (std::chrono::duration<double>(now - g_top_lastsave).count() > 120.0)
+    { g_top_lastsave = now; topn_write_locked(); }
+}
